{
  "name": "zupre",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @zupre/room-card run build && yarn workspace @zupre/printer-card run build",
    "watch": "yarn workspace @zupre/room-card run watch",
